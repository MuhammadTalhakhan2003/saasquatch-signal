# Optional AI briefs & openers for the top-ranked leads. Copy this file to .env
# and set ONE key. Without a key the app runs in heuristic mode (no cost).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=

# SIGNAL_MODEL=claude-opus-5-5
# SIGNAL_AI_MAX_LEADS=25          # AI budget per job (top-N leads only)
# SIGNAL_CONCURRENCY=8            # domains crawled in parallel
# SIGNAL_MAX_PAGES=4              # pages per domain (home + best contact/about pages)
# SIGNAL_TIMEOUT=10
# SIGNAL_RETRIES=2
# SIGNAL_CACHE_TTL_HOURS=72       # crawled pages are reused for this long
# SIGNAL_MAX_LEADS=200            # per job
# SIGNAL_PROXIES=http://user:pass@proxy1:8000,http://proxy2:8000   # rotated on 403/429
# SIGNAL_DB_PATH=data/signal.db
